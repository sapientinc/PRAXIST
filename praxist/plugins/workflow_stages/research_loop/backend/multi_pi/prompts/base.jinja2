## Output schema (write YAML to stdout, NO markdown fences)

**Claim ID format**: every `top_claims[*].id` MUST start with `C_{{ role_name }}_` so different PIs cannot collide on the same identifier. Example: `C_{{ role_name }}_g{{ generation if generation is defined else 'N' }}_01`. Chair de-duplicates only across explicit `claim_boundary_updates` entries — same-string IDs from different roles will be silently unified.

```yaml
role: {{ role_name }}
top_claims:
  - id: C_{{ role_name }}_g<gen>_<NN>   # role-prefixed claim id
    statement: "<one sentence>"
    confidence: <0..1>
    boundary: "<scope: e.g. 'current protocol only'>"
    supports: [<evidence_id>, ...]
    challenges: [<evidence_id>, ...]
    inspired_by_private_kb: <true|false>

objections_or_warnings:
  - target_claim: <claim_id>
    objection: "<one sentence>"
    severity: low | medium | blocking
    resolving_experiment: "<one sentence describing minimal kill test>"

proposed_experiments:
  - id: <exp_id>
    description: "<one sentence>"
    rationale: "<why>"
    estimated_overhead: "<low|medium|high>"
    bottleneck_target: "<optional bottleneck label>"
    evidence_stage: "{{ '<qualitative stage such as open_question|source_check|analysis|synthesis>' if scoreless else '<task-defined stage such as smoke|scout|full_eval|replication|promotion_attempt>' }}"
    tradeoff_class: "{{ '<evidence limitation or inquiry type>' if scoreless else '<strong_clean_candidate|strong_but_non_clean_repair_target|benchmark_or_reference_control|reference_like_no_task_edge|specialized_signal_repair_target|robust_low_gain_candidate|domain_signal_behavior_candidate|negative_falsifier|incomplete_evidence|task_defined>' }}"
    primary_tradeoff: "{{ '<uncertainty, source coverage, or research effort tradeoff>' if scoreless else '<quality_vs_cost|quality_vs_robustness|quality_vs_complexity|evidence_vs_runtime|custom>' }}"
    next_step_intent: "<preserve_and_validate|repair_failure_mode|ablate_or_falsify|combine_with_other_mechanism|pivot_to_distinct_surface|archive_negative_result>"
    parent_candidate: "{{ '<empty unless the task defines an implementation parent>' if scoreless else '<variant/finding id if using a strong parent, else empty>' }}"
    parent_usage: "{{ '<empty unless the task defines an implementation parent; cite narrative evidence separately>' if scoreless else '<empty/none only when parent_candidate is empty; for validation candidates use validate|complete_validation|complete_scored_validation|repair|falsify|compare|ablate|ablate_or_falsify|ablation_followup|audit; for durable parents preserve is allowed>' }}"

proposed_peer_contracts:
  - role: exploit | falsifier | bridge | anti_mainline | theorist
    target_hypothesis: "<id or contract reference>"
    source_lane: "<optional lane name or empty>"
    target_lane: "<optional intended lane or empty>"
    bottleneck_target: "<optional bottleneck label>"
    evidence_stage: "{{ '<qualitative stage such as open_question|source_check|analysis|synthesis>' if scoreless else '<task-defined stage such as smoke|scout|full_eval|replication|promotion_attempt>' }}"
    tradeoff_class: "{{ '<evidence limitation or inquiry type>' if scoreless else '<strong_clean_candidate|strong_but_non_clean_repair_target|benchmark_or_reference_control|reference_like_no_task_edge|specialized_signal_repair_target|robust_low_gain_candidate|domain_signal_behavior_candidate|negative_falsifier|incomplete_evidence|task_defined>' }}"
    primary_tradeoff: "{{ '<uncertainty, source coverage, or research effort tradeoff>' if scoreless else '<quality_vs_cost|quality_vs_robustness|quality_vs_complexity|evidence_vs_runtime|custom>' }}"
    next_step_intent: "<preserve_and_validate|repair_failure_mode|ablate_or_falsify|combine_with_other_mechanism|pivot_to_distinct_surface|archive_negative_result>"
    parent_candidate: "{{ '<empty unless the task defines an implementation parent>' if scoreless else '<variant/finding id if using a strong parent, else empty>' }}"
    parent_usage: "{{ '<empty unless the task defines an implementation parent; cite narrative evidence separately>' if scoreless else '<empty/none only when parent_candidate is empty; for validation candidates use validate|complete_validation|complete_scored_validation|repair|falsify|compare|ablate|ablate_or_falsify|ablation_followup|audit; for durable parents preserve is allowed>' }}"
